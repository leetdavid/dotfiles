# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host ws
  HostName office.bilby.ai
  User david
  ForwardAgent yes
  Port 22

Host ws-airflow
  HostName office.bilby.ai
  User airflow
  ForwardAgent yes

Host ws-usman
  HostName office.bilby.ai
  User usman
  ForwardAgent yes

Host unraid
  HostName 10.0.10.151
  User root
  ProxyJump ws

Host server.eslee.io
  HostName 10.0.10.151
  # User root
  ProxyJump ws

Host mac
  HostName 10.0.10.152
  User david
  ProxyJump ws
