{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.4-mini",
  "provider": {
    "openai": {
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{file:~/.config/opencode/.cli-proxy-api-key}",
      },
    },
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "chrome-devtools-mcp@latest"],
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
    },
  },
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "cors": ["http://example.com", "http://macmini.localhost"],
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "@warp-dot-dev/opencode-warp@0.1.5",
  ],
  "autoupdate": true,
}
