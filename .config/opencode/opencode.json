{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "mcp": {
    "railway": {
      "command": [
        "railway",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "tldraw": {
      "type": "remote",
      "url": "https://tldraw-mcp-app.tldraw.workers.dev/mcp",
      "enabled": true
    }
  },
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    },
    "openai": {
      "options": {
        "apiKey": "{file:~/.config/opencode/.cli-proxy-api-key}",
        "baseURL": "http://127.0.0.1:8317/v1"
      }
    }
  },
  "server": {
    "cors": [
      "http://mac.li-tone.ts.net",
      "http://mac"
    ],
    "hostname": "0.0.0.0",
    "mdns": true,
    "port": 4096
  },
  "small_model": "openai/gpt-5.6-luna"
}
