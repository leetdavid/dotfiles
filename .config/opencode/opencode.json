{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "mcp": {
    "servers": {
      "railway": {
        "command": [
          "railway",
          "mcp"
        ],
        "disabled": false,
        "type": "local"
      },
      "tldraw": {
        "disabled": false,
        "type": "remote",
        "url": "https://tldraw-mcp-app.tldraw.workers.dev/mcp"
      }
    }
  },
  "providers": {
    "ollama": {
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      }
    },
    "openai": {
      "settings": {
        "apiKey": "{file:~/.config/opencode/.cli-proxy-api-key}",
        "baseURL": "http://127.0.0.1:8317/v1"
      }
    }
  },
  "agents": {
    "title": {
      "model": "openai/gpt-5.6-luna"
    }
  }
}
