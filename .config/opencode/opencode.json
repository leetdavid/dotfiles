{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "username": "david",
  "mcp": {
    "servers": {
      "railway": {
        "command": [
          "railway",
          "mcp"
        ],
        "disabled": false,
        "type": "local"
      },
      "tldraw": {
        "disabled": false,
        "type": "remote",
        "url": "https://tldraw-mcp-app.tldraw.workers.dev/mcp"
      },
      "doop": {
        "type": "remote",
        "url": "https://doop.design/mcp"
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      }
    }
  },
  "providers": {
    "openai": {
      "settings": {
        "apiKey": "{file:~/.config/opencode/.cli-proxy-api-key}",
        "baseURL": "http://mac.li-tone.ts.net:8317/v1"
      }
    }
  },
  "agents": {
    "title": {
      "model": "openai/gpt-6-luna"
    }
  }
}
