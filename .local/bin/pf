#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/pf/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pf"
LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"
SERVICE_PREFIX="com.david.pf"

PF_HOST="${PF_HOST:-}"
PF_REMOTE_HOST="${PF_REMOTE_HOST:-localhost}"
PF_BIND="${PF_BIND:-127.0.0.1}"
PF_BACKEND="${PF_BACKEND:-}"
PF_PROCESS_RESTART_DELAY="${PF_PROCESS_RESTART_DELAY:-2}"
PF_CHECK_ATTEMPTS="${PF_CHECK_ATTEMPTS:-30}"
PF_CHECK_DELAY="${PF_CHECK_DELAY:-0.5}"

usage() {
    printf '%s\n' \
        'Usage: pf [--host <ssh-host>] [--remote-host <host>] [--bind <addr>] <command> [args]' \
        '' \
        'Commands:' \
        '  up <port|local:remote>...   Start forwarding services' \
        '  check [--all|<port|local:remote>...] Check forwarding services and repair failures' \
        '  down <port>...              Stop forwarding services by local port' \
        '  down --all                  Stop all managed forwarding services' \
        '  restart <port>...           Restart forwarding services by local port' \
        '  restart --all               Restart all managed forwarding services' \
        '  ls                          List managed forwarding services' \
        '' \
        'Examples:' \
        '  pf up 3000' \
        '  pf up 3000:5000' \
        '  pf check' \
        '  pf check --all' \
        '  pf check 3000 4983 8000:8080' \
        '  pf up 3000 4983 8000:8080' \
        '  pf down 3000' \
        '  pf down --all' \
        '  pf restart --all' \
        '  pf --host mac --remote-host localhost --bind 127.0.0.1 up 3000'
}

usage_up() {
    printf '%s\n' \
        'Usage: pf [global-options] up <port|local:remote>...' \
        '' \
        'Starts one managed forwarding service per mapping.' \
        'Mappings are local-first, matching Docker and ssh -L.' \
        '' \
        'Examples:' \
        '  pf up 3000' \
        '  pf up 3000:5000' \
        '  pf up 3000 4983 8000:8080'
}

usage_check() {
    printf '%s\n' \
        'Usage: pf [global-options] check [--all|<port|local:remote>...]' \
        '' \
        'Checks forwarding services and repairs failures by starting or restarting them.' \
        'With no arguments, checks all managed forwarding services.' \
        'Mappings are local-first, matching Docker and ssh -L.' \
        '' \
        'Examples:' \
        '  pf check' \
        '  pf check --all' \
        '  pf check 3000' \
        '  pf check 3000 4983 8000:8080'
}

usage_down() {
    printf '%s\n' \
        'Usage: pf down <port>...' \
        '       pf down --all' \
        '' \
        'Examples:' \
        '  pf down 3000' \
        '  pf down --all'
}

usage_restart() {
    printf '%s\n' \
        'Usage: pf restart <port>...' \
        '       pf restart --all' \
        '' \
        'Restarts existing managed forwarding services from saved state.' \
        '' \
        'Examples:' \
        '  pf restart 3000' \
        '  pf restart --all'
}

die() {
    printf '[pf] %s\n' "$1" >&2
    exit "${2:-1}"
}

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck source=/dev/null
        . "$CONFIG_FILE"
    fi
}

validate_name() {
    local value="$1"
    local label="$2"

    case "$value" in
        ''|*[!A-Za-z0-9._:@-]*) die "invalid $label: $value" 2 ;;
    esac
}

validate_current_profile() {
    [[ -n "$PF_HOST" ]] || die "missing PF_HOST. Set it in $CONFIG_FILE or pass --host <ssh-host>. Example: pf --host mac check 3000" 2
    validate_name "$PF_HOST" 'host'
    validate_name "$PF_REMOTE_HOST" 'remote host'
    validate_name "$PF_BIND" 'bind address'
}

mapping_has_remote_port() {
    [[ "$1" == *:* ]]
}

validate_port() {
    local port="$1"

    case "$port" in
        ''|*[!0-9]*) die "invalid port: $port" 2 ;;
    esac

    if ((port < 1 || port > 65535)); then
        die "port out of range: $port" 2
    fi
}

validate_positive_integer() {
    local value="$1"
    local label="$2"

    case "$value" in
        ''|*[!0-9]*) die "invalid $label: $value" 2 ;;
    esac

    if ((value < 1)); then
        die "$label must be at least 1: $value" 2
    fi
}

xml_escape() {
    local value="$1"
    value=${value//&/&amp;}
    value=${value//</&lt;}
    value=${value//>/&gt;}
    value=${value//\"/&quot;}
    value=${value//\'/&apos;}
    printf '%s' "$value"
}

label_for() {
    printf '%s.%s' "$SERVICE_PREFIX" "$1"
}

plist_path_for() {
    printf '%s/%s.plist' "$LAUNCH_AGENTS_DIR" "$(label_for "$1")"
}

pid_path_for() {
    printf '%s/%s.pid' "$STATE_DIR" "$1"
}

ssh_pid_path_for() {
    printf '%s/%s.ssh.pid' "$STATE_DIR" "$1"
}

process_script_path_for() {
    printf '%s/%s.process.sh' "$STATE_DIR" "$1"
}

stop_path_for() {
    printf '%s/%s.stop' "$STATE_DIR" "$1"
}

out_log_path_for() {
    printf '%s/%s.out.log' "$STATE_DIR" "$1"
}

err_log_path_for() {
    printf '%s/%s.err.log' "$STATE_DIR" "$1"
}

state_path_for() {
    printf '%s/%s.state' "$STATE_DIR" "$1"
}

domain() {
    printf 'gui/%s' "$(id -u)"
}

service_target() {
    printf '%s/%s' "$(domain)" "$(label_for "$1")"
}

detect_backend() {
    if [[ -n "$PF_BACKEND" ]]; then
        case "$PF_BACKEND" in
            launchd|process) printf '%s\n' "$PF_BACKEND" ;;
            *) die "invalid PF_BACKEND: $PF_BACKEND. Expected launchd or process" 2 ;;
        esac
        return
    fi

    case "$(uname -s)" in
        Darwin) printf 'launchd\n' ;;
        *) printf 'process\n' ;;
    esac
}

ensure_backend_dependencies() {
    case "$PF_BACKEND" in
        launchd)
            command -v launchctl >/dev/null 2>&1 || die 'launchctl not found; set PF_BACKEND=process on systems without launchd' 1
            [[ -x /usr/bin/ssh ]] || die 'ssh not found at /usr/bin/ssh' 1
            ;;
        process)
            command -v nohup >/dev/null 2>&1 || die 'nohup not found; install coreutils before starting process-backed services' 1
            command -v ssh >/dev/null 2>&1 || die 'ssh not found; install OpenSSH first. On Termux: pkg install openssh' 1
            ;;
    esac
}

read_pid_file() {
    local path="$1"
    local pid

    [[ -f "$path" ]] || return 1
    IFS= read -r pid <"$path" || return 1
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    printf '%s\n' "$pid"
}

pid_is_running() {
    kill -0 "$1" >/dev/null 2>&1
}

local_port_is_listening() {
    command -v lsof >/dev/null 2>&1 || return 1
    lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

connect_host_for_bind() {
    case "$1" in
        ''|0.0.0.0|::|::0) printf 'localhost' ;;
        *) printf '%s' "$1" ;;
    esac
}

local_forward_accepts_connections() {
    local host
    host="$(connect_host_for_bind "$PF_BIND")"

    if command -v nc >/dev/null 2>&1; then
        nc -z -w 1 "$host" "$1" >/dev/null 2>&1
        return
    fi

    if (: >"/dev/tcp/$host/$1") >/dev/null 2>&1; then
        return 0
    fi

    local_port_is_listening "$1"
}

log_size_for() {
    local path
    path="$(err_log_path_for "$1")"

    [[ -f "$path" ]] || {
        printf '0'
        return
    }

    wc -c <"$path"
}

log_has_connect_failure_since() {
    local local_port="$1"
    local offset="$2"
    local path appended
    path="$(err_log_path_for "$local_port")"

    [[ -f "$path" ]] || return 1
    appended="$(tail -c +$((offset + 1)) "$path" 2>/dev/null || true)"
    [[ "$appended" == *'open failed: connect failed'* ]]
}

forwarded_connection_works() {
    local local_port="$1"
    local offset

    offset="$(log_size_for "$local_port")"
    local_forward_accepts_connections "$local_port" || return 1
    sleep 0.3
    ! log_has_connect_failure_since "$local_port" "$offset"
}

forwarding_works() {
    local local_port="$1"

    is_loaded "$local_port" && forwarded_connection_works "$local_port"
}

wait_for_forwarding() {
    local local_port="$1"
    local i

    validate_positive_integer "$PF_CHECK_ATTEMPTS" 'PF_CHECK_ATTEMPTS'

    for ((i = 1; i <= PF_CHECK_ATTEMPTS; i++)); do
        if forwarding_works "$local_port"; then
            return 0
        fi
        sleep "$PF_CHECK_DELAY"
    done

    return 1
}

launchd_is_loaded() {
    launchctl print "$(service_target "$1")" >/dev/null 2>&1
}

process_is_loaded() {
    local pid

    pid="$(read_pid_file "$(pid_path_for "$1")")" || return 1
    pid_is_running "$pid"
}

is_loaded() {
    case "$PF_BACKEND" in
        launchd) launchd_is_loaded "$1" ;;
        process) process_is_loaded "$1" ;;
    esac
}

service_state() {
    if ! is_loaded "$1"; then
        printf 'stopped'
        return
    fi

    case "$PF_BACKEND" in
        launchd) printf 'loaded' ;;
        process) printf 'running' ;;
    esac
}

parse_mapping() {
    local spec="$1"

    case "$spec" in
        *:*:*) die "invalid mapping: $spec" 2 ;;
        *:*)
            LOCAL_PORT="${spec%%:*}"
            REMOTE_PORT="${spec#*:}"
            ;;
        *)
            LOCAL_PORT="$spec"
            REMOTE_PORT="$spec"
            ;;
    esac

    validate_port "$LOCAL_PORT"
    validate_port "$REMOTE_PORT"
}

write_state() {
    local local_port="$1"
    local remote_port="$2"
    local state_path
    state_path="$(state_path_for "$local_port")"

    mkdir -p "$STATE_DIR"
    {
        printf 'pf_label=%s\n' "$(label_for "$local_port")"
        printf 'pf_backend=%s\n' "$PF_BACKEND"
        printf 'pf_local_port=%s\n' "$local_port"
        printf 'pf_remote_port=%s\n' "$remote_port"
        printf 'pf_host=%s\n' "$PF_HOST"
        printf 'pf_remote_host=%s\n' "$PF_REMOTE_HOST"
        printf 'pf_bind=%s\n' "$PF_BIND"
    } >"$state_path"
}

state_matches() {
    local local_port="$1"
    local remote_port="$2"
    local state_path
    state_path="$(state_path_for "$local_port")"

    [[ -f "$state_path" ]] || return 1

    local pf_label='' pf_backend="$PF_BACKEND" pf_local_port='' pf_remote_port='' pf_host='' pf_remote_host='' pf_bind=''
    # shellcheck source=/dev/null
    . "$state_path"

    [[ "$local_port" == "$pf_local_port" \
        && "$PF_BACKEND" == "$pf_backend" \
        && "$remote_port" == "$pf_remote_port" \
        && "$PF_HOST" == "$pf_host" \
        && "$PF_REMOTE_HOST" == "$pf_remote_host" \
        && "$PF_BIND" == "$pf_bind" ]]
}

existing_state_summary() {
    local local_port="$1"
    local state_path
    state_path="$(state_path_for "$local_port")"

    if [[ ! -f "$state_path" ]]; then
        printf 'no managed state'
        return
    fi

    local pf_label='' pf_backend="$PF_BACKEND" pf_local_port='' pf_remote_port='' pf_host='' pf_remote_host='' pf_bind=''
    # shellcheck source=/dev/null
    . "$state_path"
    printf 'local %s -> %s:%s via %s bind %s backend %s' "$pf_local_port" "$pf_remote_host" "$pf_remote_port" "$pf_host" "$pf_bind" "$pf_backend"
}

load_state_for_restart() {
    local local_port="$1"
    local state_path pf_label='' pf_backend='' pf_local_port='' pf_remote_port='' pf_host='' pf_remote_host='' pf_bind=''
    state_path="$(state_path_for "$local_port")"

    [[ -f "$state_path" ]] || die "local port $local_port has no managed state. Start it first with: pf up $local_port" 1

    # shellcheck source=/dev/null
    . "$state_path"

    case "$pf_backend" in
        launchd|process) PF_BACKEND="$pf_backend" ;;
        *) die "local port $local_port has invalid backend in managed state: $pf_backend" 1 ;;
    esac

    PF_HOST="$pf_host"
    PF_REMOTE_HOST="$pf_remote_host"
    PF_BIND="$pf_bind"
    LOCAL_PORT="$pf_local_port"
    REMOTE_PORT="$pf_remote_port"
}

state_backend_for() {
    local local_port="$1"
    local state_path pf_label='' pf_backend="$PF_BACKEND" pf_local_port='' pf_remote_port='' pf_host='' pf_remote_host='' pf_bind=''
    state_path="$(state_path_for "$local_port")"

    if [[ -f "$state_path" ]]; then
        # shellcheck source=/dev/null
        . "$state_path"
    else
        pf_backend="$PF_BACKEND"
    fi

    case "$pf_backend" in
        launchd|process) printf '%s\n' "$pf_backend" ;;
        *) printf '%s\n' "$PF_BACKEND" ;;
    esac
}

bootout_managed_service() {
    local local_port="$1"
    local previous_backend="$PF_BACKEND"

    PF_BACKEND="$(state_backend_for "$local_port")"
    bootout_service "$local_port"
    PF_BACKEND="$previous_backend"
}

managed_service_state() {
    local local_port="$1"
    local previous_backend="$PF_BACKEND"
    local state

    PF_BACKEND="$(state_backend_for "$local_port")"
    state="$(service_state "$local_port")"
    PF_BACKEND="$previous_backend"
    printf '%s' "$state"
}

write_plist() {
    local local_port="$1"
    local label plist out_log err_log script

    label="$(label_for "$local_port")"
    plist="$(plist_path_for "$local_port")"
    out_log="$(out_log_path_for "$local_port")"
    err_log="$(err_log_path_for "$local_port")"
    script="$(process_script_path_for "$local_port")"

    mkdir -p "$STATE_DIR" "$LAUNCH_AGENTS_DIR"
    {
        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
        printf '%s\n' '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
        printf '%s\n' '<plist version="1.0">'
        printf '%s\n' '<dict>'
        printf '  <key>Label</key><string>%s</string>\n' "$(xml_escape "$label")"
        printf '  <key>ProgramArguments</key>\n'
        printf '  <array>\n'
        printf '    <string>%s</string>\n' "$(xml_escape "$script")"
        printf '  </array>\n'
        printf '  <key>RunAtLoad</key><true/>\n'
        printf '  <key>StandardOutPath</key><string>%s</string>\n' "$(xml_escape "$out_log")"
        printf '  <key>StandardErrorPath</key><string>%s</string>\n' "$(xml_escape "$err_log")"
        printf '%s\n' '</dict>'
        printf '%s\n' '</plist>'
    } >"$plist"
}

write_process_script() {
    local local_port="$1"
    local remote_port="$2"
    local script out_log err_log pid_file ssh_pid_file stop_file forward_arg ssh_bin

    script="$(process_script_path_for "$local_port")"
    out_log="$(out_log_path_for "$local_port")"
    err_log="$(err_log_path_for "$local_port")"
    pid_file="$(pid_path_for "$local_port")"
    ssh_pid_file="$(ssh_pid_path_for "$local_port")"
    stop_file="$(stop_path_for "$local_port")"
    forward_arg="$PF_BIND:$local_port:$PF_REMOTE_HOST:$remote_port"
    ssh_bin="$(command -v ssh)"

    mkdir -p "$STATE_DIR"
    {
        printf '%s\n' '#!/usr/bin/env bash'
        printf '%s\n' 'set -u'
        printf 'ssh_bin=%q\n' "$ssh_bin"
        printf 'forward_arg=%q\n' "$forward_arg"
        printf 'bind_addr=%q\n' "$PF_BIND"
        printf 'local_port=%q\n' "$local_port"
        printf 'ssh_host=%q\n' "$PF_HOST"
        printf 'out_log=%q\n' "$out_log"
        printf 'err_log=%q\n' "$err_log"
        printf 'pid_file=%q\n' "$pid_file"
        printf 'ssh_pid_file=%q\n' "$ssh_pid_file"
        printf 'stop_file=%q\n' "$stop_file"
        printf 'restart_delay=%q\n' "$PF_PROCESS_RESTART_DELAY"
        printf '%s\n' 'child_pid='
        printf '%s\n' 'stop() {'
        printf '%s\n' '    touch "$stop_file"'
        printf '%s\n' '    if [[ -n "${child_pid:-}" ]]; then'
        printf '%s\n' '        kill "$child_pid" >/dev/null 2>&1 || true'
        printf '%s\n' '        wait "$child_pid" >/dev/null 2>&1 || true'
        printf '%s\n' '    fi'
        printf '%s\n' '    rm -f "$pid_file" "$ssh_pid_file" "$stop_file"'
        printf '%s\n' '    exit 0'
        printf '%s\n' '}'
        printf '%s\n' 'trap stop INT TERM'
        printf '%s\n' 'printf "%s\n" "$$" >"$pid_file"'
        printf '%s\n' 'rm -f "$ssh_pid_file"'
        printf '%s\n' 'while [[ ! -f "$stop_file" ]]; do'
        printf '%s\n' '    if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$local_port" -sTCP:LISTEN >/dev/null 2>&1; then'
        printf '%s\n' '        printf "[pf] local %s:%s is already in use; stopping supervisor\n" "$bind_addr" "$local_port" >>"$err_log"'
        printf '%s\n' '        break'
        printf '%s\n' '    fi'
        printf '%s\n' '    "$ssh_bin" -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L "$forward_arg" "$ssh_host" >>"$out_log" 2>>"$err_log" &'
        printf '%s\n' '    child_pid=$!'
        printf '%s\n' '    printf "%s\n" "$child_pid" >"$ssh_pid_file"'
        printf '%s\n' '    wait "$child_pid"'
        printf '%s\n' '    status=$?'
        printf '%s\n' '    child_pid='
        printf '%s\n' '    rm -f "$ssh_pid_file"'
        printf '%s\n' '    [[ -f "$stop_file" ]] && break'
        printf '%s\n' '    printf "[pf] ssh exited with status %s at %s\n" "$status" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$err_log"'
        printf '%s\n' '    sleep "$restart_delay" &'
        printf '%s\n' '    child_pid=$!'
        printf '%s\n' '    wait "$child_pid" >/dev/null 2>&1 || true'
        printf '%s\n' '    child_pid='
        printf '%s\n' 'done'
        printf '%s\n' 'rm -f "$pid_file" "$ssh_pid_file" "$stop_file"'
    } >"$script"
    chmod 700 "$script"
}

write_service() {
    case "$PF_BACKEND" in
        launchd)
            write_process_script "$@"
            write_plist "$@"
            ;;
        process) write_process_script "$@" ;;
    esac
}

bootstrap_launchd_service() {
    local local_port="$1"
    local plist
    plist="$(plist_path_for "$local_port")"

    if is_loaded "$local_port"; then
        return
    fi

    launchctl bootstrap "$(domain)" "$plist"
}

bootstrap_process_service() {
    local local_port="$1"
    local script pid
    script="$(process_script_path_for "$local_port")"

    if is_loaded "$local_port"; then
        return
    fi

    rm -f "$(pid_path_for "$local_port")" "$(ssh_pid_path_for "$local_port")" "$(stop_path_for "$local_port")"
    nohup "$script" >/dev/null 2>&1 &
    pid=$!
    printf '%s\n' "$pid" >"$(pid_path_for "$local_port")"
}

bootstrap_service() {
    case "$PF_BACKEND" in
        launchd) bootstrap_launchd_service "$@" ;;
        process) bootstrap_process_service "$@" ;;
    esac
}

bootout_launchd_service() {
    local local_port="$1"
    local plist pid ssh_pid i
    plist="$(plist_path_for "$local_port")"

    mkdir -p "$STATE_DIR"
    touch "$(stop_path_for "$local_port")"

    if is_loaded "$local_port" || [[ -f "$plist" ]]; then
        launchctl bootout "$(domain)" "$plist" >/dev/null 2>&1 || true
    fi

    if pid="$(read_pid_file "$(pid_path_for "$local_port")")"; then
        kill "$pid" >/dev/null 2>&1 || true
    fi
    if ssh_pid="$(read_pid_file "$(ssh_pid_path_for "$local_port")")"; then
        kill "$ssh_pid" >/dev/null 2>&1 || true
    fi

    for i in 1 2 3 4 5; do
        if { [[ -z "${pid:-}" ]] || ! pid_is_running "$pid"; } && { [[ -z "${ssh_pid:-}" ]] || ! pid_is_running "$ssh_pid"; }; then
            break
        fi
        sleep 0.2
    done

    if [[ -n "${pid:-}" ]] && pid_is_running "$pid"; then
        kill -KILL "$pid" >/dev/null 2>&1 || true
    fi
    if [[ -n "${ssh_pid:-}" ]] && pid_is_running "$ssh_pid"; then
        kill -KILL "$ssh_pid" >/dev/null 2>&1 || true
    fi

    rm -f "$(pid_path_for "$local_port")" "$(ssh_pid_path_for "$local_port")" "$(stop_path_for "$local_port")"
}

bootout_process_service() {
    local local_port="$1"
    local pid ssh_pid i

    mkdir -p "$STATE_DIR"
    touch "$(stop_path_for "$local_port")"

    if pid="$(read_pid_file "$(pid_path_for "$local_port")")"; then
        kill "$pid" >/dev/null 2>&1 || true
    fi
    if ssh_pid="$(read_pid_file "$(ssh_pid_path_for "$local_port")")"; then
        kill "$ssh_pid" >/dev/null 2>&1 || true
    fi

    for i in 1 2 3 4 5; do
        if ! is_loaded "$local_port"; then
            break
        fi
        sleep 0.2
    done

    if [[ -n "${pid:-}" ]] && pid_is_running "$pid"; then
        kill -KILL "$pid" >/dev/null 2>&1 || true
    fi
    if [[ -n "${ssh_pid:-}" ]] && pid_is_running "$ssh_pid"; then
        kill -KILL "$ssh_pid" >/dev/null 2>&1 || true
    fi

    rm -f "$(pid_path_for "$local_port")" "$(ssh_pid_path_for "$local_port")" "$(process_script_path_for "$local_port")" "$(stop_path_for "$local_port")"
}

bootout_service() {
    case "$PF_BACKEND" in
        launchd) bootout_launchd_service "$@" ;;
        process) bootout_process_service "$@" ;;
    esac
}

remove_service_files() {
    rm -f "$(plist_path_for "$1")" "$(process_script_path_for "$1")" "$(pid_path_for "$1")" "$(ssh_pid_path_for "$1")" "$(stop_path_for "$1")"
}

cmd_up() {
    [[ $# -gt 0 ]] || {
        usage_up >&2
        exit 2
    }

    for spec in "$@"; do
        [[ "$spec" == '-h' || "$spec" == '--help' ]] && {
            usage_up
            exit 0
        }
    done

    PF_BACKEND="$(detect_backend)"
    [[ -n "$PF_HOST" ]] || die "missing PF_HOST. Set it in $CONFIG_FILE or pass --host <ssh-host>. Example: pf --host mac up 3000" 2
    validate_name "$PF_HOST" 'host'
    validate_name "$PF_REMOTE_HOST" 'remote host'
    validate_name "$PF_BIND" 'bind address'
    ensure_backend_dependencies

    for spec in "$@"; do
        parse_mapping "$spec"

        if [[ -f "$(state_path_for "$LOCAL_PORT")" ]] && ! state_matches "$LOCAL_PORT" "$REMOTE_PORT"; then
            die "local port $LOCAL_PORT already has a different managed forward: $(existing_state_summary "$LOCAL_PORT")" 1
        fi

        if ! is_loaded "$LOCAL_PORT" && local_port_is_listening "$LOCAL_PORT"; then
            die "local port $LOCAL_PORT is already in use" 1
        fi

        write_state "$LOCAL_PORT" "$REMOTE_PORT"
        write_service "$LOCAL_PORT" "$REMOTE_PORT"
        bootstrap_service "$LOCAL_PORT"

        if is_loaded "$LOCAL_PORT"; then
            printf '[pf] up local %s -> %s:%s via %s\n' "$LOCAL_PORT" "$PF_REMOTE_HOST" "$REMOTE_PORT" "$PF_HOST"
        else
            die "failed to start local port $LOCAL_PORT; check $STATE_DIR/$LOCAL_PORT.err.log" 1
        fi
    done
}

check_current_mapping() {
    local local_port="$LOCAL_PORT"
    local remote_port="$REMOTE_PORT"

    if forwarding_works "$local_port"; then
        printf '[pf] ok local %s -> %s:%s via %s\n' "$local_port" "$PF_REMOTE_HOST" "$remote_port" "$PF_HOST"
        return
    fi

    restart_port "$local_port"
    if wait_for_forwarding "$LOCAL_PORT"; then
        printf '[pf] ok local %s -> %s:%s via %s\n' "$LOCAL_PORT" "$PF_REMOTE_HOST" "$REMOTE_PORT" "$PF_HOST"
    else
        die "local port $LOCAL_PORT did not pass the forwarding check after repair; check $STATE_DIR/$LOCAL_PORT.err.log" 1
    fi
}

cmd_check() {
    if [[ $# -eq 0 ]]; then
        set -- --all
    fi

    for spec in "$@"; do
        [[ "$spec" == '-h' || "$spec" == '--help' ]] && {
            usage_check
            exit 0
        }
    done

    PF_BACKEND="$(detect_backend)"

    if [[ "$1" == '--all' ]]; then
        [[ $# -eq 1 ]] || die 'check --all does not accept port arguments' 2

        local state_file local_port checked=0
        shopt -s nullglob
        for state_file in "$STATE_DIR"/*.state; do
            local_port="${state_file##*/}"
            local_port="${local_port%.state}"
            load_state_for_restart "$local_port"
            ensure_backend_dependencies
            check_current_mapping
            checked=1
        done
        shopt -u nullglob

        if [[ "$checked" == 0 ]]; then
            printf '[pf] no managed forwarding services\n'
        fi
        return
    fi

    for spec in "$@"; do
        if ! mapping_has_remote_port "$spec" && [[ -f "$(state_path_for "$spec")" ]]; then
            validate_port "$spec"
            load_state_for_restart "$spec"
            ensure_backend_dependencies
            check_current_mapping
            continue
        fi

        parse_mapping "$spec"
        validate_current_profile
        ensure_backend_dependencies

        if [[ -f "$(state_path_for "$LOCAL_PORT")" ]]; then
            if state_matches "$LOCAL_PORT" "$REMOTE_PORT"; then
                check_current_mapping
                continue
            fi

            die "local port $LOCAL_PORT already has a different managed forward: $(existing_state_summary "$LOCAL_PORT")" 1
        fi

        if local_port_is_listening "$LOCAL_PORT"; then
            die "local port $LOCAL_PORT is already in use" 1
        fi

        write_state "$LOCAL_PORT" "$REMOTE_PORT"
        write_service "$LOCAL_PORT" "$REMOTE_PORT"
        bootstrap_service "$LOCAL_PORT"

        if is_loaded "$LOCAL_PORT"; then
            printf '[pf] up local %s -> %s:%s via %s\n' "$LOCAL_PORT" "$PF_REMOTE_HOST" "$REMOTE_PORT" "$PF_HOST"
        else
            die "failed to start local port $LOCAL_PORT; check $STATE_DIR/$LOCAL_PORT.err.log" 1
        fi

        if wait_for_forwarding "$LOCAL_PORT"; then
            printf '[pf] ok local %s -> %s:%s via %s\n' "$LOCAL_PORT" "$PF_REMOTE_HOST" "$REMOTE_PORT" "$PF_HOST"
        else
            die "local port $LOCAL_PORT did not pass the forwarding check after start; check $STATE_DIR/$LOCAL_PORT.err.log" 1
        fi
    done
}

cmd_down() {
    [[ $# -gt 0 ]] || {
        usage_down >&2
        exit 2
    }

    if [[ "$1" == '-h' || "$1" == '--help' ]]; then
        usage_down
        exit 0
    fi

    PF_BACKEND="$(detect_backend)"

    if [[ "$1" == '--all' ]]; then
        [[ $# -eq 1 ]] || die 'down --all does not accept port arguments' 2

        local state_file local_port
        shopt -s nullglob
        for state_file in "$STATE_DIR"/*.state; do
            local_port="${state_file##*/}"
            local_port="${local_port%.state}"
            bootout_managed_service "$local_port"
            remove_service_files "$local_port"
            rm -f "$(state_path_for "$local_port")"
            printf '[pf] down local %s\n' "$local_port"
        done
        shopt -u nullglob
        return
    fi

    local port
    for port in "$@"; do
        validate_port "$port"
        bootout_managed_service "$port"
        remove_service_files "$port"
        rm -f "$(state_path_for "$port")"
        printf '[pf] down local %s\n' "$port"
    done
}

restart_port() {
    local port="$1"

    validate_port "$port"
    load_state_for_restart "$port"
    ensure_backend_dependencies

    bootout_service "$LOCAL_PORT"

    if local_port_is_listening "$LOCAL_PORT"; then
        die "local port $LOCAL_PORT is already in use" 1
    fi

    write_service "$LOCAL_PORT" "$REMOTE_PORT"
    bootstrap_service "$LOCAL_PORT"

    if is_loaded "$LOCAL_PORT"; then
        printf '[pf] restarted local %s -> %s:%s via %s\n' "$LOCAL_PORT" "$PF_REMOTE_HOST" "$REMOTE_PORT" "$PF_HOST"
    else
        die "failed to restart local port $LOCAL_PORT; check $STATE_DIR/$LOCAL_PORT.err.log" 1
    fi
}

cmd_restart() {
    [[ $# -gt 0 ]] || {
        usage_restart >&2
        exit 2
    }

    if [[ "$1" == '-h' || "$1" == '--help' ]]; then
        usage_restart
        exit 0
    fi

    PF_BACKEND="$(detect_backend)"

    if [[ "$1" == '--all' ]]; then
        [[ $# -eq 1 ]] || die 'restart --all does not accept port arguments' 2

        local state_file local_port restarted=0
        shopt -s nullglob
        for state_file in "$STATE_DIR"/*.state; do
            local_port="${state_file##*/}"
            local_port="${local_port%.state}"
            restart_port "$local_port"
            restarted=1
        done
        shopt -u nullglob

        if [[ "$restarted" == 0 ]]; then
            printf '[pf] no managed forwarding services\n'
        fi
        return
    fi

    local port
    for port in "$@"; do
        restart_port "$port"
    done
}

cmd_ls() {
    if [[ $# -gt 0 ]]; then
        if [[ "$1" == '-h' || "$1" == '--help' ]]; then
            printf '%s\n' \
                'Usage: pf ls' \
                '' \
                'Lists managed forwarding services.' \
                '' \
                'Example:' \
                '  pf ls'
            exit 0
        fi

        die 'ls does not accept arguments' 2
    fi

    PF_BACKEND="$(detect_backend)"
    mkdir -p "$STATE_DIR"

    printf '%-8s %-22s %-18s %-16s %s\n' 'LOCAL' 'REMOTE' 'HOST' 'BIND' 'STATE'

    local state_file local_port pf_label='' pf_backend='' pf_local_port='' pf_remote_port='' pf_host='' pf_remote_host='' pf_bind='' state
    shopt -s nullglob
    for state_file in "$STATE_DIR"/*.state; do
        local_port="${state_file##*/}"
        local_port="${local_port%.state}"
        pf_label='' pf_backend='' pf_local_port='' pf_remote_port='' pf_host='' pf_remote_host='' pf_bind=''
        # shellcheck source=/dev/null
        . "$state_file"
        state="$(managed_service_state "$local_port")"
        printf '%-8s %-22s %-18s %-16s %s\n' "$pf_local_port" "$pf_remote_host:$pf_remote_port" "$pf_host" "$pf_bind" "$state"
    done
    shopt -u nullglob
}

load_config

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --host)
            [[ $# -ge 2 ]] || die 'missing value for --host' 2
            PF_HOST="$2"
            shift 2
            ;;
        --host=*)
            PF_HOST="${1#*=}"
            shift
            ;;
        --remote-host)
            [[ $# -ge 2 ]] || die 'missing value for --remote-host' 2
            PF_REMOTE_HOST="$2"
            shift 2
            ;;
        --remote-host=*)
            PF_REMOTE_HOST="${1#*=}"
            shift
            ;;
        --bind)
            [[ $# -ge 2 ]] || die 'missing value for --bind' 2
            PF_BIND="$2"
            shift 2
            ;;
        --bind=*)
            PF_BIND="${1#*=}"
            shift
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

cmd="${1:-}"
[[ -n "$cmd" ]] || {
    usage >&2
    exit 2
}
shift

case "$cmd" in
    up) cmd_up "$@" ;;
    check) cmd_check "$@" ;;
    down) cmd_down "$@" ;;
    restart) cmd_restart "$@" ;;
    ls|list) cmd_ls "$@" ;;
    *)
        die "unknown command: $cmd" 2
        ;;
esac
