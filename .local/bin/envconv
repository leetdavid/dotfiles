#!/usr/bin/env bash
# envconv - convert between .env and .env.example
# Commands: strip, scaffold

set -euo pipefail

# ── Helpers ────────────────────────────────────────────────────────────────

die()  { echo "envconv: error: $*" >&2; exit 1; }
info() { echo "envconv: $*"; }

find_example_file() {
    if [[ -f ".env.example" ]]; then echo ".env.example"
    elif [[ -f "example.env" ]]; then echo "example.env"
    else die "no example env file found (.env.example or example.env)"
    fi
}

# ── Commands ───────────────────────────────────────────────────────────────

cmd_strip() {
    local input=".env" output=".env.example"

    [[ ${1-} ]] && input="$1"
    [[ ${2-} ]] && output="$2"

    [[ -f "$input" ]] || die "input file not found: $input"

    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*# || -z "$line" ]]; then
            printf '%s\n' "$line"
        elif [[ "$line" =~ ^(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)= ]]; then
            local prefix="${BASH_REMATCH[1]}" key="${BASH_REMATCH[2]}"
            printf '%s%s=\n' "$prefix" "$key"
        else
            printf '%s\n' "$line"
        fi
    done < "$input" > "$output"

    info "wrote $output"
}

cmd_scaffold() {
    local force=0 input="" output=".env"

    while [[ ${1-} ]]; do
        case "$1" in
            -f|--force) force=1 ;;
            -*) die "unknown flag: $1" ;;
            *) if [[ -z "$input" ]]; then input="$1"; else output="$1"; fi ;;
        esac
        shift
    done

    [[ -z "$input" ]] && input="$(find_example_file)"
    [[ -f "$input" ]] || die "input file not found: $input"
    [[ -f "$output" && "$force" -eq 0 ]] && die "$output already exists (use --force to overwrite)"

    cp "$input" "$output"
    info "wrote $output"
}

cmd_help() {
    cat <<'EOF'
envconv - convert between .env and .env.example

Usage:
  envconv strip   [input] [output]   strip values from env file
  envconv scaffold [input] [output]  scaffold .env from example file

Commands:
  strip     Convert .env → .env.example by removing all values.
            Preserves comments and blank lines.
            Default: reads .env, writes .env.example

  scaffold  Copy .env.example → .env as-is.
            Auto-detects .env.example or example.env if no input given.
            Default: reads .env.example, writes .env
            Flags: -f, --force  overwrite output if it exists

Examples:
  envconv strip                      # .env → .env.example
  envconv strip .env.local .env.local.example
  envconv scaffold                   # .env.example → .env
  envconv scaffold --force           # overwrite existing .env
  envconv scaffold example.env .env
EOF
}

# ── Dispatch ───────────────────────────────────────────────────────────────

cmd="${1-}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
    strip)    cmd_strip "$@" ;;
    scaffold) cmd_scaffold "$@" ;;
    help|-h|--help) cmd_help ;;
    "") cmd_help ;;
    *) die "unknown command: $cmd. Try: envconv help" ;;
esac
